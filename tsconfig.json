{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "react-native-country-codes-picker": [
        "types/shims/react-native-country-codes-picker.d.ts"
      ],
      "react-native-gifted-chat": [
        "types/shims/react-native-gifted-chat.d.ts"
      ],
      "react-native-zoom-reanimated": [
        "types/shims/react-native-zoom-reanimated.d.ts"
      ]
    },
    "preserveSymlinks": true
  },
  "exclude": [
    "node_modules",
    "__tests__",
    "__mocks__",
    "cypress",
    "client-sdk-ts",
    "crypto-ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "babel.config.js",
    "metro.config.js"
  ]
}
