# -----------------------------------------------------------------------------
# Environment variables for the Expo application
#
# IMPORTANT:
# To expose a variable to the client-side app code, it MUST be prefixed
# with `EXPO_PUBLIC_`. This is a security feature of Expo to prevent
# accidentally leaking sensitive keys.
# -----------------------------------------------------------------------------

EXPO_PUBLIC_TEST="THIS IS A TEST"
EXPO_PUBLIC_ROOT_GOVERNING_KEY_PUB=

# -----------------------------------------------------------------------------
# SDK & Application Operation Mode
# -----------------------------------------------------------------------------
# Defines the operational mode for the SDK. Use 'DEMO' for development to
# enable mock data and wallets. Set to 'PRODUCTION' for release builds.
EXPO_PUBLIC_OPERATION_MODE=DEMO
EXPO_PUBLIC_ICA_DID_LIST=

# Allowed sectors in this app instance. If a sector is not listed here,
# its operator/provider list is ignored and the picker will show no options.
EXPO_PUBLIC_ALLOWED_SECTOR_LIST=health-care,health-insurance

# Professional operator DID lists by sector (comma-separated DID values).
# Use full did:web (including host path/jurisdiction/version/sector when applicable).
EXPO_PUBLIC_PROFESSIONAL_OPERATOR_LIST_HEALTH_CARE=did:web:localhost%3A3000:host:cds-es:v1:health-care
EXPO_PUBLIC_PROFESSIONAL_OPERATOR_LIST_HEALTH_INSURANCE=did:web:localhost%3A3000:host:cds-es:v1:health-insurance
EXPO_PUBLIC_PROFESSIONAL_OPERATOR_LIST_EMERGENCY=
EXPO_PUBLIC_PROFESSIONAL_OPERATOR_LIST_HEALTH_TECH=
EXPO_PUBLIC_PROFESSIONAL_OPERATOR_LIST_HEALTH_IT=
EXPO_PUBLIC_PROFESSIONAL_OPERATOR_LIST_RESEARCH=

# Family provider DID lists by sector (comma-separated DID values).
# If your family UI does not select sector yet, the app uses the union of all allowed sectors.
EXPO_PUBLIC_FAMILY_PROVIDER_LIST_HEALTH_CARE=did:web:localhost%3A3000:provider:cds-es:v1:health-care
EXPO_PUBLIC_FAMILY_PROVIDER_LIST_HEALTH_INSURANCE=
EXPO_PUBLIC_FAMILY_PROVIDER_LIST_EMERGENCY=
EXPO_PUBLIC_FAMILY_PROVIDER_LIST_HEALTH_TECH=
EXPO_PUBLIC_FAMILY_PROVIDER_LIST_HEALTH_IT=
EXPO_PUBLIC_FAMILY_PROVIDER_LIST_RESEARCH=

EXPO_PUBLIC_SUBMIT_RETRY_COUNT=2
EXPO_PUBLIC_SUBMIT_RETRY_DELAY_MS=1500
EXPO_PUBLIC_REGISTRY_REFRESH_INTERVAL_MS=2500
EXPO_PUBLIC_RETRY_REGISTER_FAMILY_ORG_COUNT=
EXPO_PUBLIC_RETRY_REGISTER_FAMILY_ORG_DELAY_MS=
EXPO_PUBLIC_RETRY_REGISTER_ORG_COUNT=
EXPO_PUBLIC_RETRY_REGISTER_ORG_DELAY_MS=
EXPO_PUBLIC_FAMILY_ROLE_CODING_SYSTEM=org.hl7.v3.RoleCode
EXPO_PUBLIC_ORG_ROLE_CODING_SYSTEM=org.ilo.isco-08
EXPO_PUBLIC_FAMILY_ROLE_SEND_SYSTEM=true
EXPO_PUBLIC_ORG_ROLE_SEND_SYSTEM=true

# Set to 'true' to enable legacy FHIR mode, if supported.
EXPO_PUBLIC_LEGACY_MODE=true

# Firebase Project Configuration (for client-side SDK initialization)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth Client IDs (for Google Sign-In)
# These are also considered public and are required by the client.
# Please verify that these are your correct IDs.
EXPO_PUBLIC_GOOGLE_API_WEB_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_API_IOS_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_API_ANDROID_CLIENT_ID=""
